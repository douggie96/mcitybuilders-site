---
/**
 * ScrollHero — "Studs to finished, on one camera".
 *
 * One locked-off kitchen changes stage by stage under the scroll wheel. The
 * frames are drawn to <canvas> (the Apple product-page technique: an image
 * sequence, not a <video>, because video cannot be seeked smoothly from scroll).
 *
 * Frame-count agnostic. With a handful of frames it cross-dissolves between
 * neighbours; with 100+ it plays as continuous motion. Same code either way.
 *
 * Contract:
 *  - Scroll is NEVER locked or hijacked. No smooth-scroll library. The page
 *    scrolls natively; this only READS scroll position in a rAF loop.
 *  - Every word is real DOM over the canvas, never painted into it. The H1 is
 *    always in the DOM and never display:none.
 *  - Cinematic mode is opt-in: a tiny inline script in <head> (index.astro) adds
 *    `.cine` to <html> before first paint, and only when JS runs, motion is allowed and
 *    Save-Data is off. Without it (no JS, reduced motion, Save-Data) the hero is
 *    a plain labelled storyboard. No layout shift either way.
 *  - Canvas backing store is capped at DPR 1.5. Frames load sequentially after
 *    first paint; phones (< 768px) get the 800px frames.
 *
 * Rail storyboard (p = 0..1 across the rail):
 *   0.00–0.12  S0  black, mark centred, one specular sweep on load
 *   0.12–0.20  S1  mark flies to the nav logo (FLIP), first frame fades up
 *   0.20–0.90  S2–S5  frames scrub; label, progress bar, provenance chip
 *   ~0.76      the service sentence rises
 *   0.90–1.00  S6  CTAs; then the sticky stage unpins with the rail
 */
interface Frame { lg: string; sm: string; label: string; n: string }
interface Props {
  frames: Frame[];
  h1: string;
  eyebrow?: string;
  sentence?: string;
  provenance?: string;
  phone: string;
  phoneHref: string;
}
const {
  frames, h1,
  eyebrow = 'Studs to finished, on one camera',
  sentence = 'Kitchens, bathrooms, decks and full renovations across Central Massachusetts.',
  provenance = 'Visualisation — not a photo of our work',
  phone, phoneHref,
} = Astro.props;
const W = 1600, H = 905;
---
<section class="hero" id="hero" aria-labelledby="hero-h1">
  <div class="hero__rail">
    <div class="hero__stage">
      <canvas class="hero__canvas" data-canvas aria-hidden="true"></canvas>
      <div class="hero__black" data-black aria-hidden="true"></div>

      <div class="hero__open" data-open>
        <span class="hero__markWrap" data-mark>
          <img class="hero__mark" src="/brand/mcb-mark-696.webp"
               srcset="/brand/mcb-mark-480.webp 480w, /brand/mcb-mark-696.webp 696w"
               sizes="(max-width: 767px) 72vw, 560px"
               alt="Maverick City Builders" width="696" height="164" fetchpriority="high" />
          <span class="hero__sweep" aria-hidden="true"></span>
        </span>
        <p class="hero__slogan" data-fade>Design<span class="hero__dot" aria-hidden="true"> · </span>Build<span class="hero__dot" aria-hidden="true"> · </span>Renovate</p>
        <h1 class="hero__h1" id="hero-h1" data-fade>{h1}</h1>
      </div>

      <div class="hero__ui" data-ui>
        <p class="hero__tag">{eyebrow}</p>
        <div class="hero__meta">
          <p class="hero__label" data-label aria-live="off">{frames[0].n} · {frames[0].label}</p>
          <p class="hero__chip">{provenance}</p>
        </div>
        <div class="hero__track" aria-hidden="true"><span class="hero__bar" data-bar></span></div>
      </div>

      <div class="hero__scrim" data-scrim aria-hidden="true"></div>
      <p class="hero__sentence" data-sentence>{sentence}</p>

      <div class="hero__ctas" data-ctas>
        <a class="hbtn hbtn--red" href="#estimate" data-ev="estimate_cta">Start a project</a>
        <a class="hbtn hbtn--ghost" href="/portfolio">See real work</a>
      </div>
    </div>
  </div>

  <!-- Storyboard: the same stages, labelled. This IS the hero when motion is off
       (no JS, prefers-reduced-motion, Save-Data). In cinematic mode it is hidden
       and, being lazy, never downloaded; the canvas reads its data-* sources. -->
  <ol class="hero__stills" data-stills>
    {frames.map(f => (
      <li>
        <figure>
          <img src={f.lg} srcset={`${f.sm} 800w, ${f.lg} 1600w`}
               sizes="(max-width: 767px) 100vw, 50vw"
               data-lg={f.lg} data-sm={f.sm} data-label={`${f.n} · ${f.label}`}
               alt={`Kitchen visualisation, stage ${f.n}: ${f.label.toLowerCase()}`}
               width={W} height={H} loading="lazy" decoding="async" />
          <figcaption><span class="hero__stillN">{f.n} · {f.label}</span>
            <span class="hero__stillProv">{provenance}</span></figcaption>
        </figure>
      </li>
    ))}
  </ol>
</section>

<script>
  const section = document.getElementById('hero');
  const root = document.documentElement;
  if (section && root.classList.contains('cine')) {
    const $ = <T extends Element>(s: string) => section.querySelector(s) as T;
    const rail = $<HTMLElement>('.hero__rail');
    const canvas = $<HTMLCanvasElement>('[data-canvas]');
    const black = $<HTMLElement>('[data-black]');
    const markWrap = $<HTMLElement>('[data-mark]');
    const fades = Array.from(section.querySelectorAll<HTMLElement>('[data-fade]'));
    const ui = $<HTMLElement>('[data-ui]');
    const labelEl = $<HTMLElement>('[data-label]');
    const bar = $<HTMLElement>('[data-bar]');
    const sentence = $<HTMLElement>('[data-sentence]');
    const scrim = $<HTMLElement>('[data-scrim]');
    const ctas = $<HTMLElement>('[data-ctas]');
    const navMark = document.querySelector<HTMLElement>('[data-navmark]');
    const stills = Array.from(section.querySelectorAll<HTMLImageElement>('[data-stills] img'));
    const ctx = canvas.getContext('2d', { alpha: false });

    const small = matchMedia('(max-width: 767px)');
    const srcs = stills.map(i => (small.matches ? i.dataset.sm : i.dataset.lg) || i.src);
    const labels = stills.map(i => i.dataset.label || '');
    const K0_BLACK = (labels[0] || '').startsWith('00');   // only when the K0 'Before' frame exists
    const N = srcs.length;
    const imgs: (HTMLImageElement | null)[] = new Array(N).fill(null);

    const clamp = (v: number) => (v < 0 ? 0 : v > 1 ? 1 : v);
    const sine = (v: number) => -(Math.cos(Math.PI * v) - 1) / 2;   // sine.inOut
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

    // ---- canvas sizing: CSS box x DPR, DPR capped at 1.5
    let cw = 0, ch = 0;
    const size = () => {
      const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
      cw = Math.round(canvas.clientWidth * dpr); ch = Math.round(canvas.clientHeight * dpr);
      if (canvas.width !== cw || canvas.height !== ch) { canvas.width = cw; canvas.height = ch; }
    };

    const draw = (im: HTMLImageElement, a: number) => {
      if (!ctx) return;
      const s = Math.max(cw / im.naturalWidth, ch / im.naturalHeight);
      const w = im.naturalWidth * s, h = im.naturalHeight * s;
      ctx.globalAlpha = a;
      ctx.drawImage(im, (cw - w) / 2, (ch - h) / 2, w, h);
      ctx.globalAlpha = 1;
    };
    const nearest = (i: number) => {
      for (let d = 0; d < N; d++) { if (imgs[i - d]) return imgs[i - d]; if (imgs[i + d]) return imgs[i + d]; }
      return null;
    };

    // ---- FLIP: where the big mark must land (the nav logo), measured untransformed
    let fx = 0, fy = 0, fs = 1;
    const measure = () => {
      markWrap.style.transform = '';
      if (!navMark) return;
      const a = markWrap.getBoundingClientRect(), b = navMark.getBoundingClientRect();
      if (!a.width) return;
      fs = b.width / a.width;
      fx = (b.left + b.width / 2) - (a.left + a.width / 2);
      fy = (b.top + b.height / 2) - (a.top + a.height / 2);
    };

    let raf = 0, lastLabel = -1, lastPast = false;
    const render = () => {
      raf = 0;
      const r = rail.getBoundingClientRect();
      const span = r.height - window.innerHeight;
      const p = span > 0 ? clamp(-r.top / span) : 0;

      // S1 0.12–0.20: mark flies to the nav, black lifts, first frame fades up
      const s1 = clamp((p - 0.12) / 0.08), e = sine(s1);
      markWrap.style.transform = `translate3d(${(fx * e).toFixed(1)}px,${(fy * e).toFixed(1)}px,0) scale(${lerp(1, fs, e).toFixed(4)})`;
      markWrap.style.opacity = s1 >= 1 ? '0' : '1';
      const landed = s1 >= 1;
      if (landed !== lastPast) { root.classList.toggle('hero-past', landed); lastPast = landed; }
      const fo = clamp(1 - s1 * 1.6);
      fades.forEach(el => { el.style.opacity = String(fo); });   // H1 label: fully visible at rest, fades as the mark flies
      black.style.opacity = String(1 - e);
      canvas.style.opacity = String(e);

      // S2–S5 0.20–0.90: the build
      const t = clamp((p - 0.20) / 0.70);
      const exact = t * (N - 1), i = Math.floor(exact);
      // Few frames: hold each stage and dissolve only through the middle of the
      // gap (AI stages are not pixel-registered, so a long dissolve ghosts).
      // Many frames (a real time-lapse): plain linear blend = continuous motion.
      const HOLD = N < 12 ? 0.3 : 0;
      const f = sine(clamp((exact - i - HOLD) / (1 - 2 * HOLD)));
      const a = imgs[i] ?? nearest(i);
      const b = imgs[i + 1];
      if (ctx && i === 0 && K0_BLACK && a && b && f > 0) {
        // 00 Before -> 01 Gutted: a fade THROUGH black, not a cross-dissolve.
        // The dated kitchen and the gutted room share almost nothing but the
        // window, so blending them ghosts badly; a dip to black reads as a cut.
        ctx.fillStyle = "#000"; ctx.fillRect(0, 0, cw, ch);
        if (f < 0.5) draw(a, 1 - f * 2); else draw(b, (f - 0.5) * 2);
      } else if (a) { draw(a, 1); if (b && f > 0) draw(b, f); }
      if (!small.matches) {
        const g = exact / Math.max(1, N - 1);   // cold (gutted) -> warm (finished)
        canvas.style.filter = `saturate(${lerp(.72, 1.06, g).toFixed(3)}) contrast(${lerp(1.07, 1, g).toFixed(3)}) ` +
          `brightness(${lerp(.9, 1.02, g).toFixed(3)}) sepia(${lerp(0, .12, g).toFixed(3)}) hue-rotate(${lerp(-10, 0, g).toFixed(1)}deg)`;
      }
      ui.style.opacity = String(clamp((p - 0.16) / 0.04));
      bar.style.transform = `scaleX(${t.toFixed(4)})`;
      const li = Math.round(exact);
      if (li !== lastLabel && labels[li]) { labelEl.textContent = labels[li]; lastLabel = li; }

      // ~0.76: the sentence rises
      const sr = sine(clamp((p - 0.72) / 0.06));
      sentence.style.opacity = String(sr);
      scrim.style.opacity = String(Math.max(sr, 0));
      sentence.style.transform = `translate3d(0,${((1 - sr) * 28).toFixed(1)}px,0)`;

      // 0.90–1.00: CTAs
      const c = sine(clamp((p - 0.88) / 0.05));
      ctas.style.opacity = String(c);
      ctas.style.transform = `translate3d(0,${((1 - c) * 16).toFixed(1)}px,0)`;
      ctas.style.visibility = c > 0.01 ? 'visible' : 'hidden';
    };
    const tick = () => { if (!raf) raf = requestAnimationFrame(render); };

    const load = (i: number) => new Promise<void>(res => {
      const im = new Image();
      im.decoding = 'async';
      im.onload = () => { imgs[i] = im; res(); };
      im.onerror = () => res();              // a missing frame is skipped, never fatal
      im.src = srcs[i];
    });

    size(); measure(); render();
    addEventListener('scroll', tick, { passive: true });
    addEventListener('resize', () => { size(); measure(); tick(); }, { passive: true });
    // Fonts landing can move the nav logo by a pixel or two: re-measure once.
    document.fonts?.ready.then(() => { measure(); tick(); });

    // Frames after first paint, strictly one at a time: parallel decodes of
    // full-bleed images stall the main thread on exactly the phones that matter.
    requestAnimationFrame(() => setTimeout(() => {
      srcs.reduce((chain, _, i) => chain.then(() => load(i)).then(tick), Promise.resolve());
    }, 0));
  }
</script>

<style>
  .hero { position: relative; background: var(--black); color: #fff; }

  /* ---------- storyboard (default: no JS / reduced motion / Save-Data) ---------- */
  .hero__stage { position: relative; display: grid; justify-items: center; gap: 1.6rem;
    padding: calc(var(--hh) + 48px) var(--gutter) 40px; text-align: center; }
  .hero__canvas, .hero__black, .hero__ui, .hero__scrim { display: none; }
  .hero__open { display: grid; justify-items: center; gap: 1.1rem; }
  .hero__open .hero__h1 { margin-top: -.2rem; }
  .hero__markWrap { position: relative; display: block; width: min(72vw, 560px); transform-origin: 50% 50%; }
  .hero__mark { width: 100%; height: auto; }
  .hero__sweep { position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(105deg, transparent 38%, rgba(255,255,255,.95) 50%, transparent 62%) 150% 0 / 260% 100% no-repeat;
    -webkit-mask: url(/brand/mcb-mark-696.webp) center / contain no-repeat;
            mask: url(/brand/mcb-mark-696.webp) center / contain no-repeat;
    opacity: 0; }
  /* The H1 is a small label under the mark (Doug, 2026-09-29): same element, same
     text, restyled. rgba(192,192,192,.85) on #000 = ~9.6:1 contrast (WCAG AA/AAA). */
  .hero__h1 { margin: 0; font: 500 clamp(11px, 1.1vw, 14px)/1.6 var(--orb); letter-spacing: .18em;
    text-transform: uppercase; color: rgba(192,192,192,.85); text-wrap: balance;
    max-width: 100%; white-space: nowrap; }
  @media (max-width: 767px) { .hero__h1 { white-space: normal; max-width: 100%; } }
  /* Tagline (Doug, 2026-09-29). A <p>, not a heading. The dots are the single red
     UI accent on the opening screen (the red CTA only appears at p >= 0.88). */
  .hero__slogan { margin: 0; font: 700 clamp(16px, 1.9vw, 26px)/1.2 var(--orb); letter-spacing: .3em;
    text-transform: uppercase; color: #fff; white-space: nowrap; margin-inline-end: -.3em; }
  .hero__dot { color: var(--red); }
  @media (max-width: 767px) { .hero__slogan { font-size: 16px; letter-spacing: .16em; margin-inline-end: -.16em; } }
  .hero__tag { margin: 0; font: 400 .64rem/1.3 var(--mono); letter-spacing: .04em; color: var(--silver-lo); }
  .hero__sentence { margin: 0; font-weight: 300; font-size: clamp(1.25rem, 3.2vw, 2.1rem); line-height: 1.2;
    letter-spacing: -.02em; max-width: 26ch; color: #fff; }
  .hero__ctas { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }

  .hero__stills { list-style: none; margin: 0; padding: 0 var(--gutter) clamp(40px, 6vw, 80px);
    display: grid; gap: 18px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); }
  .hero__stills figure { margin: 0; }
  .hero__stills img { width: 100%; height: auto; aspect-ratio: 1600 / 905; background: var(--carbon); }
  .hero__stills figcaption { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 12px; padding-top: .6rem; }
  .hero__stillN { font: 500 .72rem/1.3 var(--orb); letter-spacing: .06em; text-transform: uppercase; color: #fff; }
  .hero__stillProv { font: 400 .66rem/1.3 var(--mono); letter-spacing: .04em; color: var(--silver-lo); }

  /* ---------- cinematic ---------- */
  :global(.cine) .hero__stills { display: none; }
  :global(.cine) .hero__rail { height: 520vh; }
  @media (max-width: 767px) { :global(.cine) .hero__rail { height: 380vh; } }
  :global(.cine) .hero__stage { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden;
    display: block; padding: 0; text-align: left; }
  :global(.cine) .hero__canvas { display: block; position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; }
  :global(.cine) .hero__black { display: block; position: absolute; inset: 0; background: var(--black); }
  :global(.cine) .hero__open { position: absolute; inset: 0; z-index: 2; place-content: center; text-align: center;
    padding: var(--hh) var(--gutter) 0; pointer-events: none; }
  :global(.cine) .hero__markWrap { will-change: transform; }
  :global(.cine) .hero__sweep { animation: mcb-sweep 1.1s .35s cubic-bezier(.45,0,.55,1) 1 both; }
  @keyframes mcb-sweep { 0% { opacity: 1; background-position: 150% 0; } 100% { opacity: 1; background-position: -50% 0; } }

  :global(.cine) .hero__ui { display: grid; gap: 12px; position: absolute; z-index: 3; left: 0; right: 0; bottom: 0;
    padding: 64px var(--gutter) max(22px, env(safe-area-inset-bottom)); opacity: 0;
    background: linear-gradient(to top, rgba(0,0,0,.78), rgba(0,0,0,0)); }
  .hero__meta { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 8px 16px; }
  .hero__label { margin: 0; font: 700 clamp(.82rem, 1.6vw, 1rem)/1.2 var(--orb); letter-spacing: .06em;
    text-transform: uppercase; color: #fff; }
  .hero__chip { margin: 0; font: 400 .66rem/1.2 var(--mono); letter-spacing: .04em; color: #fff;
    background: rgba(0,0,0,.55); border: 1px solid rgba(192,192,192,.35); padding: 5px 8px; }
  .hero__track { height: 2px; background: rgba(192,192,192,.22); }
  .hero__bar { display: block; height: 100%; background: linear-gradient(90deg, var(--silver-lo), var(--silver-hi));
    transform: scaleX(0); transform-origin: 0 50%; }

  :global(.cine) .hero__scrim { display: block; position: absolute; inset: 0; z-index: 2; opacity: 0; pointer-events: none;
    background: linear-gradient(to top, rgba(0,0,0,.88) 0%, rgba(0,0,0,.6) 30%, rgba(0,0,0,0) 62%),
                linear-gradient(to right, rgba(0,0,0,.45), rgba(0,0,0,0) 60%); }
  :global(.cine) .hero__sentence { position: absolute; z-index: 3; left: var(--gutter); right: var(--gutter);
    bottom: 170px; opacity: 0; text-shadow: 0 2px 24px rgba(0,0,0,.55); }
  :global(.cine) .hero__ctas { position: absolute; z-index: 3; left: var(--gutter); bottom: 92px;
    justify-content: flex-start; opacity: 0; visibility: hidden; }
  @media (max-width: 767px) {
    :global(.cine) .hero__sentence { bottom: 206px; font-size: 1.3rem; }
    :global(.cine) .hero__ctas { bottom: 124px; right: var(--gutter); }
    :global(.cine) .hero__ctas .hbtn { flex: 1 1 0; justify-content: center; padding-inline: 12px; }
  }
</style>
