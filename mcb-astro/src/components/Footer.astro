---
import { SITE, SERVICES } from '../data/site';
const A = SITE.address;
---
<footer class="ft">
  <div class="wrap">
    <div class="ft__top">
      <div>
        <span class="eyebrow">Maverick City Builders</span>
        <p class="ft__pitch">General contracting and remodeling across Massachusetts.</p>
        <a class="btn btn--onDark" href="/contact" data-ev="estimate_cta">Request an estimate</a>
      </div>
      <nav aria-label="Services"><h2 class="ft__h">Services</h2>
        <ul>{SERVICES.map(s => <li><a href={`/${s.slug}`}>{s.title}</a></li>)}</ul>
      </nav>
      <nav aria-label="Company"><h2 class="ft__h">Company</h2>
        <ul>
          <li><a href="/about">About</a></li><li><a href="/portfolio">Our work</a></li>
          <li><a href="/areas-we-serve">Areas we serve</a></li><li><a href="/blog">Articles</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </nav>
      <div><h2 class="ft__h">Contact</h2>
        <address class="ft__nap">
          <a href={SITE.phoneHref} data-ev="phone_click">{SITE.phone}</a>
          <a href={`mailto:${SITE.email}`} data-ev="email_click">{SITE.email}</a>
          <span>{A.street}<br />{A.locality}, {A.region} {A.postalCode}</span>
          <em>{SITE.addressNote}</em>
        </address>
      </div>
    </div>
    <hr class="rule" />
    <div class="ft__base">
      <p>&copy; {new Date().getFullYear()} Maverick City Builders &middot; {SITE.licensing}</p>
      <p><a href="/privacy-policy">Privacy</a> &middot; <a href="/terms">Terms</a> &middot;
         <a href="/accessibility">Accessibility</a> &middot; <a href="/cookie-policy">Cookies</a></p>
    </div>
  </div>
</footer>
<style>
  .ft{background:var(--ink-deep);color:#EFEAE0;padding-block:clamp(56px,7vw,96px) 34px;margin-top:0}
  .ft .eyebrow{color:rgba(239,234,224,.56)}
  .ft__top{display:grid;gap:clamp(30px,4vw,54px);grid-template-columns:1fr}
  @media (min-width:860px){.ft__top{grid-template-columns:1.6fr 1fr 1fr 1.15fr}}
  .ft__pitch{font-size:var(--step-1);font-weight:250;letter-spacing:-.03em;line-height:1.2;
    color:#FFFDF8;max-width:22ch;margin:0 0 1.6rem}
  .ft__h{font-family:var(--mono);font-size:.68rem;font-weight:500;letter-spacing:.18em;
    text-transform:uppercase;color:rgba(239,234,224,.56);margin:0 0 1rem}
  .ft ul{list-style:none;margin:0;padding:0;display:grid;gap:.6rem;font-size:.93rem}
  .ft a{color:rgba(239,234,224,.86)}.ft a:hover{color:#fff;text-decoration:underline}
  .ft__nap{font-style:normal;display:grid;gap:.6rem;font-size:.93rem;color:rgba(239,234,224,.86)}
  .ft__nap em{font-style:normal;color:rgba(239,234,224,.52);font-size:.85rem}
  .ft .rule{background:rgba(239,234,224,.15);margin-block:clamp(34px,4vw,54px) 22px}
  .ft__base{display:flex;flex-wrap:wrap;gap:10px 26px;justify-content:space-between;
    font-size:.8rem;color:rgba(239,234,224,.56)}
  .ft__base p{margin:0}
</style>
