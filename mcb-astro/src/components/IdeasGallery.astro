---
/** Swatch + room "ideas" cards, one per sub-service page. Used on /flooring, /painting,
 *  and (as static HTML injected by publish tooling) on /deck-building and /carpentry.
 *  Every image is an AI design-idea illustration; the note below says so. */
interface Item { href: string; name: string; card: string; costRange: string;
  image: string; swatch: string; imageAlt: string; swatchAlt: string }
interface Props { heading: string; sub?: string; items: Item[]; id?: string }
const { heading, sub, items, id = 'ideas' } = Astro.props;
---
<section class="ideas" aria-labelledby={`${id}-h`}>
  <h2 id={`${id}-h`}>{heading}</h2>
  {sub && <p class="sub">{sub}</p>}
  <ul class="grid">
    {items.map((d) => (
      <li>
        <a class="card" href={d.href}>
          <span class="pair">
            <img src={d.swatch} alt={d.swatchAlt} width="800" height="800" loading="lazy" decoding="async" />
            <img src={d.image} alt={d.imageAlt} width="1600" height="1195" loading="lazy" decoding="async" />
          </span>
          <span class="txt">
            <strong>{d.name}</strong>
            <span>{d.card}</span>
            <span class="cost">{d.costRange.includes('$') ? `Typical: ${d.costRange}` : d.costRange}</span>
          </span>
        </a>
      </li>
    ))}
  </ul>
  <p class="note">Photos are AI design-idea illustrations, not photos of Maverick City Builders projects.</p>
</section>
<style>
  .ideas { max-width: 1240px; margin: 0 auto; padding: 3rem 1.25rem 1rem; }
  .sub { color: var(--stone); margin-top: -.25rem; }
  .grid { list-style: none; padding: 0; margin: 1.5rem 0 0; display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); }
  .card { display: block; height: 100%; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; color: inherit; text-decoration: none; background: #fff; transition: border-color .2s; }
  .card:hover, .card:focus-visible { border-color: var(--ink); }
  .pair { display: grid; grid-template-columns: 1fr 1.6fr; gap: 2px; background: var(--line); }
  .pair img { width: 100%; height: 190px; object-fit: cover; display: block; }
  .txt { display: grid; gap: .3rem; padding: 1rem 1.1rem 1.15rem; }
  .txt strong { font-size: var(--step-1); }
  .txt span { color: var(--ink-soft); font-size: .95rem; }
  .txt .cost { font-family: var(--mono); font-size: .8rem; color: var(--stone); }
  .note { font-size: .8rem; color: var(--stone); margin-top: 1rem; }
</style>
