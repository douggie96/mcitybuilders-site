---
import { SITE, SERVICES } from '../data/site';
---
<header class="hd">
  <div class="wrap hd__in">
    <a class="hd__logo" href="/" aria-label={SITE.name + ' home'}>
      <span class="hd__mark">MCB</span>
      <span class="hd__name">Maverick City Builders</span>
    </a>
    <nav class="hd__nav" aria-label="Primary">
      <details class="hd__drop">
        <summary>Services</summary>
        <ul>{SERVICES.map(s => <li><a href={`/${s.slug}`}>{s.title}</a></li>)}</ul>
      </details>
      <a href="/painting">Painting</a>
      <a href="/portfolio">Our work</a>
      <a href="/areas-we-serve">Areas we serve</a>
      <a href="/about">About</a>
    </nav>
    <div class="hd__act">
      <a class="hd__tel" href={SITE.phoneHref} data-ev="phone_click">{SITE.phone}</a>
      <a class="btn hd__cta" href="/contact" data-ev="estimate_cta">Free estimate</a>
      <button class="hd__burger" aria-label="Open menu" aria-expanded="false" aria-controls="mnav">
        <span></span><span></span>
      </button>
    </div>
  </div>
  <nav class="mnav" id="mnav" hidden aria-label="Mobile">
    <div class="wrap">
      {SERVICES.map(s => <a href={`/${s.slug}`}>{s.title}</a>)}
      <hr class="rule" />
      <a href="/painting">Painting</a><a href="/portfolio">Our work</a><a href="/areas-we-serve">Areas we serve</a>
      <a href="/about">About</a><a href="/contact">Free estimate</a>
      <a class="mnav__tel" href={SITE.phoneHref} data-ev="phone_click">{SITE.phone}</a>
    </div>
  </nav>
</header>
<style>
  .hd{position:sticky;top:0;z-index:50;background:color-mix(in srgb,var(--paper) 88%,transparent);
      backdrop-filter:saturate(140%) blur(10px);border-bottom:1px solid var(--line)}
  .hd__in{display:flex;align-items:center;gap:clamp(16px,3vw,42px);min-height:72px}
  .hd__logo{display:flex;align-items:center;gap:.7rem;flex:0 0 auto}
  .hd__mark{background:var(--signal);color:#fff;font-weight:800;font-size:.78rem;
            letter-spacing:.06em;padding:6px 8px;border-radius:2px}
  .hd__name{font-weight:600;letter-spacing:-.02em;font-size:.95rem;white-space:nowrap}
  .hd__nav{display:none;gap:clamp(14px,2vw,28px);margin-inline-start:auto;font-size:.92rem;font-weight:500}
  .hd__act{display:flex;align-items:center;gap:14px;margin-inline-start:auto}
  .hd__tel{display:none;font-family:var(--mono);font-size:.85rem}
  .hd__cta{display:none;min-height:44px;padding:0 1.15rem;font-size:.85rem}
  .hd__drop{position:relative}
  .hd__drop summary{cursor:pointer;list-style:none}
  .hd__drop summary::-webkit-details-marker{display:none}
  .hd__drop ul{position:absolute;top:calc(100% + 14px);left:-16px;margin:0;padding:10px;
    min-width:264px;list-style:none;background:var(--paper);border:1px solid var(--line);
    box-shadow:0 18px 44px rgba(10,9,7,.13)}
  .hd__drop li a{display:block;padding:9px 12px;font-weight:400}
  .hd__drop li a:hover{background:var(--paper-2)}
  .hd__burger{width:44px;height:44px;display:grid;place-content:center;gap:5px;
    background:none;border:1px solid var(--line-strong);border-radius:2px;cursor:pointer}
  .hd__burger span{display:block;width:17px;height:1.5px;background:var(--ink)}
  .mnav{border-bottom:1px solid var(--line);background:var(--paper);padding-block:14px 26px}
  .mnav a{display:block;padding:11px 0;border-bottom:1px solid var(--line);font-size:1.02rem}
  .mnav__tel{font-family:var(--mono);border-bottom:0}
  @media (min-width:1000px){
    .hd__nav,.hd__tel,.hd__cta{display:flex}
    .hd__nav{margin-inline-start:auto}.hd__act{margin-inline-start:0}
    .hd__burger{display:none}.mnav{display:none}
  }
</style>
<script>
  const b = document.querySelector('.hd__burger') as HTMLButtonElement;
  const m = document.getElementById('mnav');
  b?.addEventListener('click', () => {
    const open = b.getAttribute('aria-expanded') === 'true';
    b.setAttribute('aria-expanded', String(!open));
    if (m) m.hidden = open;
    b.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
  });
</script>
