---
/**
 * Homepage-only header. Fixed, carbon, sits over the black hero.
 * The nav logo is the FLIP target the hero mark flies into ([data-navmark]).
 * In cinematic mode the nav logo appears once the mark has landed (html.hero-past,
 * p >= 0.20). The phone number is ALWAYS visible, from the very first screen
 * (desktop: mono text in the bar; phones: the number itself as a 44px tap target).
 * Every internal link the production homepage header carried is kept.
 */
import { SITE, SERVICES } from '../../data/site';
---
<header class="hh">
  <div class="hh__in">
    <a class="hh__logo" href="/" aria-label={SITE.name + ' home'}>
      <img class="hh__mark" data-navmark src="/brand/mcb-mark-240.webp" alt="" width="240" height="57" />
    </a>
    <nav class="hh__nav" aria-label="Primary">
      <details class="hh__drop">
        <summary>Services</summary>
        <ul>
          {SERVICES.map(s => <li><a href={`/${s.slug}`}>{s.title}</a></li>)}
          <li><a href="/services">All services</a></li>
        </ul>
      </details>
      <a href="/portfolio">Our work</a>
      <a href="/areas-we-serve">Areas</a>
      <a href="/about">About</a>
      <a href="/blog">Articles</a>
      <a href="/calculator">Cost calculator</a>
    </nav>
    <div class="hh__act">
      <a class="hh__tel" href={SITE.phoneHref} data-ev="phone_click">{SITE.phone}</a>
      <a class="hh__call" href={SITE.phoneHref} data-ev="phone_click" aria-label={'Call ' + SITE.phone}>{SITE.phone}</a>
      <a class="hh__cta" href="/contact" data-ev="estimate_cta">Free estimate</a>
      <button class="hh__burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="hmnav">
        <span></span><span></span>
      </button>
    </div>
  </div>
  <nav class="hmnav" id="hmnav" hidden aria-label="Mobile">
    {SERVICES.map(s => <a href={`/${s.slug}`}>{s.title}</a>)}
    <a href="/services">All services</a>
    <a href="/portfolio">Our work</a><a href="/areas-we-serve">Areas we serve</a>
    <a href="/about">About</a><a href="/blog">Articles</a><a href="/calculator">Cost calculator</a>
    <a href="/contact">Free estimate</a>
    <a class="hmnav__tel" href={SITE.phoneHref} data-ev="phone_click">{SITE.phone}</a>
  </nav>
</header>

<script>
  const b = document.querySelector<HTMLButtonElement>('.hh__burger');
  const m = document.getElementById('hmnav');
  b?.addEventListener('click', () => {
    const open = b.getAttribute('aria-expanded') === 'true';
    b.setAttribute('aria-expanded', String(!open));
    b.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
    if (m) m.hidden = open;
  });
</script>

<style>
  .hh { position: fixed; inset: 0 0 auto; z-index: 60; color: #fff;
    background: rgba(11,11,12,.86); backdrop-filter: blur(10px) saturate(130%);
    border-bottom: 1px solid rgba(192,192,192,.14); transition: background .4s ease; }
  .hh__in { display: flex; align-items: center; gap: clamp(14px, 2.4vw, 36px);
    height: var(--hh); padding-inline: var(--gutter); max-width: 1600px; margin-inline: auto; }
  .hh__logo { display: block; flex: 0 0 auto; }
  .hh__mark { width: 112px; height: auto; transition: opacity .15s linear; }
  .hh__nav { display: none; gap: clamp(14px, 1.8vw, 28px); margin-inline-start: auto;
    font-size: .88rem; color: rgba(255,255,255,.82); }
  .hh__nav a:hover, .hh__drop summary:hover { color: #fff; }
  .hh__act { display: flex; align-items: center; gap: 12px; margin-inline-start: auto; }
  .hh__tel { display: none; font: 400 .84rem/1 var(--mono); letter-spacing: .02em; color: #fff;
    transition: opacity .22s ease; }
  .hh__call { display: inline-flex; align-items: center; min-height: 44px; padding: 0 10px;
    font: 400 .78rem/1 var(--mono); letter-spacing: 0; white-space: nowrap;
    color: #fff; border: 1px solid rgba(192,192,192,.55); }
  .hh__cta { display: none; align-items: center; min-height: 44px; padding: 0 16px;
    font: 500 .72rem/1 var(--orb); letter-spacing: .06em; text-transform: uppercase;
    color: var(--silver-hi); border: 1px solid rgba(192,192,192,.55); }
  .hh__cta:hover { color: #fff; border-color: #fff; }
  .hh__drop { position: relative; }
  .hh__drop summary { cursor: pointer; list-style: none; }
  .hh__drop summary::-webkit-details-marker { display: none; }
  .hh__drop ul { position: absolute; top: calc(100% + 18px); left: -18px; margin: 0; padding: 10px;
    min-width: 260px; list-style: none; background: var(--carbon); border: 1px solid rgba(192,192,192,.2); }
  .hh__drop li a { display: block; padding: 9px 12px; }
  .hh__drop li a:hover { background: #1a1a1c; }
  .hh__burger { width: 44px; height: 44px; display: grid; place-content: center; gap: 5px;
    background: none; border: 1px solid rgba(192,192,192,.4); cursor: pointer; }
  .hh__burger span { display: block; width: 17px; height: 1.5px; background: #fff; }
  .hmnav { max-height: calc(100svh - var(--hh)); overflow-y: auto; padding: 8px var(--gutter) 24px;
    background: var(--carbon); border-top: 1px solid rgba(192,192,192,.14); }
  .hmnav a { display: block; padding: 12px 0; border-bottom: 1px solid rgba(192,192,192,.14); }
  .hmnav__tel { font-family: var(--mono); border-bottom: 0 !important; }
  @media (min-width: 1100px) {
    .hh__nav, .hh__tel, .hh__cta { display: flex; }
    .hh__call, .hh__burger, .hmnav { display: none; }
    .hh__act { margin-inline-start: 0; }
  }

  /* Cinematic mode: before the mark lands, the header is transparent, and the
     nav logo slot and the phone wait. Keyboard focus always reveals them. */
  :global(.cine:not(.hero-past)) .hh { background: transparent; backdrop-filter: none; border-color: transparent; }
  :global(.cine:not(.hero-past)) .hh__mark { opacity: 0; }
  :global(.cine:not(.hero-past)) .hh__logo:focus-visible .hh__mark { opacity: 1; }
</style>
