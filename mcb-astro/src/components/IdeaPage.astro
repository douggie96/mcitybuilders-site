---
/** Shared layout for one sub-service "idea" page (flooring, decks, painting, carpentry). */
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import EstimateForm from './EstimateForm.astro';
interface Props { doc: any; siblings: any[]; base: string; hubUrl: string; hubName: string; moreHeading: string }
const { doc, siblings, base, hubUrl, hubName, moreHeading } = Astro.props;
const { Content } = await render(doc);
const d = doc.data;
const slug = doc.id.split('/').pop();
const short = (h) => h.replace(/ in (Central )?(MA|Massachusetts)$/i, '');
const url = `https://mcitybuilders.com${base}/${slug}`;
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'Service', serviceType: short(d.h1), url,
    provider: { '@id': 'https://mcitybuilders.com/#business' },
    areaServed: { '@type': 'AdministrativeArea', name: 'Central Massachusetts' } },
  { '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: d.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) },
];
---
<Base title={d.title} description={d.description} jsonLd={jsonLd}
  breadcrumbs={[{ name: 'Home', url: '/' }, { name: hubName, url: hubUrl }, { name: short(d.h1), url: `${base}/${slug}` }]}>
  <Header />
  <main id="main">
    <section class="top wrap-wide">
      <div>
        <nav class="crumb" aria-label="Breadcrumb"><a href="/">Home</a> <span aria-hidden="true">/</span> <a href={hubUrl}>{hubName}</a></nav>
        <h1>{d.h1}</h1>
        <p class="cost">{d.costRange.includes('$') ? 'Typical Central MA range: ' : ''}<strong>{d.costRange}</strong></p>
        <p class="lead">{d.card}</p>
        <a class="btn" href="#estimate">Book a free in-home consultation</a>
      </div>
      <figure>
        <img src={d.image} alt={d.imageAlt} width="1600" height="1195" fetchpriority="high" />
        <figcaption>Design idea (AI illustration) — not an MCB project photo.</figcaption>
      </figure>
    </section>
    <article class="wrap prose">
      <Content />
      <section class="faq">
        <h2>Common questions</h2>
        {d.faqs.map((f) => (<details><summary>{f.q}</summary><p>{f.a}</p></details>))}
      </section>
    </article>
    <section class="wrap-wide more">
      <h2>{moreHeading}</h2>
      <ul>
        {siblings.map((s) => (
          <li><a href={`${base}/${s.id.split('/').pop()}`}><img src={s.data.swatch} alt={s.data.swatchAlt} width="800" height="800" loading="lazy" /><span>{short(s.data.h1)}</span></a></li>
        ))}
      </ul>
      <p><a href={hubUrl}>Back to {hubName.toLowerCase()}</a></p>
    </section>
    <div id="estimate"><EstimateForm /></div>
  </main>
  <Footer />
</Base>
<style>
  .wrap { max-width: 74ch; margin: 0 auto; padding: 1.5rem 1.25rem 2rem; }
  .wrap-wide { max-width: 1240px; margin: 0 auto; padding: 2rem 1.25rem; }
  .top { display: grid; gap: 2rem; align-items: center; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); }
  .crumb, .crumb a { font-size: .85rem; color: var(--stone); }
  h1 { font-size: var(--step-3); line-height: 1.05; margin: .3rem 0 .8rem; }
  .cost { font-family: var(--mono); font-size: .9rem; }
  .lead { font-size: var(--step-0); color: var(--ink-soft); }
  .btn { display: inline-block; background: var(--ink); color: var(--paper); padding: .8rem 1.2rem; font-weight: 700; text-decoration: none; border-radius: var(--radius); }
  figure { margin: 0; }
  figure img { width: 100%; height: auto; display: block; border-radius: var(--radius); }
  figcaption { font-size: .78rem; color: var(--stone); margin-top: .4rem; }
  .prose :global(h2) { margin-top: 2.25rem; }
  .prose :global(table) { width: 100%; border-collapse: collapse; font-size: .9rem; display: block; overflow-x: auto; }
  .prose :global(th), .prose :global(td) { border-bottom: 1px solid var(--line); padding: .5rem .4rem; text-align: left; vertical-align: top; }
  .faq details { border-bottom: 1px solid var(--line); padding: .8rem 0; }
  .faq summary { font-weight: 700; cursor: pointer; }
  .more ul { list-style: none; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
  .more a { display: grid; gap: .4rem; color: inherit; text-decoration: none; font-weight: 600; font-size: .9rem; }
  .more img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: var(--radius); }
</style>
