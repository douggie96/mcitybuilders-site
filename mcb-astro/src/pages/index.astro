<script>
  /* Motion below the hero: GSAP 3 + ScrollTrigger, loaded lazily after first
     interaction or idle so it never competes with the hero. One easing family
     (power2 / sine), 600ms reveals, nothing bounces. Reduced motion or Save-Data:
     GSAP is never loaded and every element is simply there (reveals instant). */
  const root = document.documentElement;
  const rm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const sd = !!(navigator as any).connection?.saveData;

  // Rooms track arrows (desktop horizontal track; native scroll, never hijacked)
  const track = document.querySelector<HTMLElement>('[data-track]');
  document.querySelectorAll<HTMLButtonElement>('[data-rooms]').forEach(b => b.addEventListener('click', () => {
    if (!track) return;
    const card = track.querySelector<HTMLElement>('.room');
    const step = card ? card.offsetWidth + 24 : track.clientWidth * .8;
    track.scrollBy({ left: Number(b.dataset.rooms) * step, behavior: rm ? 'auto' : 'smooth' });
  }));

  if (!rm && !sd) {
    let started = false;
    const start = async () => {
      if (started) return; started = true;
      const [{ gsap }, { ScrollTrigger }] = await Promise.all([import('gsap'), import('gsap/ScrollTrigger')]);
      gsap.registerPlugin(ScrollTrigger);
      const vh = window.innerHeight;
      // Only elements still below the fold get a from-state: nothing visible pops.
      const els = gsap.utils.toArray<HTMLElement>('[data-reveal]').filter(el => el.getBoundingClientRect().top > vh);
      gsap.set(els, { opacity: 0, y: 18 });   // opacity, not autoAlpha: never visibility:hidden (keeps headings in the a11y tree)
      ScrollTrigger.batch(els, {
        start: 'top 88%', once: true,
        onEnter: (b) => gsap.to(b, { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out', stagger: 0.06, overwrite: true }),
      });
      // Proof: slow 6% parallax, desktop only
      ScrollTrigger.matchMedia({
        '(min-width: 900px)': () => {
          gsap.utils.toArray<HTMLElement>('[data-par]').forEach(img => {
            gsap.fromTo(img, { yPercent: -3 }, { yPercent: 3, ease: 'none',
              scrollTrigger: { trigger: img.parentElement, start: 'top bottom', end: 'bottom top', scrub: true } });
          });
        },
      });
      root.classList.add('gsap-on');
    };
    addEventListener('scroll', start, { once: true, passive: true });
    const idle = (window as any).requestIdleCallback || ((f: () => void) => setTimeout(f, 1200));
    addEventListener('load', () => idle(start, { timeout: 2500 }));
  }
</script>
