---
/** One page per floor type. Content lives in src/content/flooring/*.md. */
import { getCollection } from 'astro:content';
import IdeaPage from '../../components/IdeaPage.astro';
export async function getStaticPaths() {
  const docs = (await getCollection('flooring')).sort((a, b) => a.data.order - b.data.order);
  return docs.map((doc) => ({ params: { slug: doc.id }, props: { doc, siblings: docs.filter((d) => d.id !== doc.id) } }));
}
const { doc, siblings } = Astro.props;
---
<IdeaPage doc={doc} siblings={siblings} base="/flooring" hubUrl="/flooring" hubName="Flooring" moreHeading="Other flooring ideas" />
